# ========================================================
# Pureframe Backend Environment Configuration (SECRETS ONLY)
# ========================================================
# Service: COOLIFY BACKEND SERVICE (Node / Express)
# Container Port: 5000
# Exposed Domain: https://api.YOUR_DOMAIN.com
#
# CRITICAL SECURITY NOTE:
# Configure these variables inside Coolify's Environment Variables panel.
# NEVER commit real credentials to GitHub or version control.
# ========================================================

# Application Runtime
NODE_ENV=production
PORT=5000

# Allowed Frontend URL for CORS (comma-separated if multiple, no trailing slash)
# Local Development: http://localhost:5173,http://localhost:5174
# Docker Local: http://localhost:8080
# Production / Coolify: https://YOUR_DOMAIN.com
FRONTEND_URL=https://YOUR_DOMAIN.com

# --------------------------------------------------------
# MSG91 Backend Credentials (Rotated Secret - Backend ONLY)
# Never expose these credentials in any frontend bundle or VITE_* variable.
# --------------------------------------------------------
# MSG91_AUTH_KEY: Generated in MSG91 Dashboard > User Profile > AuthKey
MSG91_AUTH_KEY=your_msg91_auth_key_here

# MSG91_WIDGET_ID: From OTP Widget section in MSG91 Dashboard
MSG91_WIDGET_ID=366a666d3673323037323934

# MSG91_TEMPLATE_ID: Optional DLT Template ID if using direct Flow/Template OTP
MSG91_TEMPLATE_ID=

# MSG91_SENDER_ID: Optional Sender Header ID (6 characters) approved on DLT
MSG91_SENDER_ID=

# --------------------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------------------
# In Coolify, create a PostgreSQL database service and paste its credentials here:
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGDATABASE=pureframe_db
PGPASSWORD=your_postgres_password_here
